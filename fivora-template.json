{
  "framework": "nextjs-static-export",
  "version": 2,
  "visualEditing": {
    "contractVersion": 1,
    "mode": "strict",
    "controlOnlyPaths": [
      "common.newsletterDescription",
      "products[*].id",
      "products[*].isAvailable",
      "services[*].id",
      "products[*].currency",
      "about.collageImages[*].id",
      "contact.whatsapp",
      "home.destinations[*].id",
      "home.destinations[*].mapX",
      "home.destinations[*].mapY"
    ]
  },
  "siteDataFile": "src/data/site-data.json",
  "outputDirectory": "out",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "basePathEnvVar": "NEXT_PUBLIC_SITE_BASE_PATH",
  "pages": [
    {
      "id": "home",
      "label": "Home",
      "route": "/",
      "required": true
    },
    {
      "id": "about_us",
      "label": "About Us",
      "route": "/about_us"
    },
    {
      "id": "services",
      "label": "Services",
      "route": "/services"
    },
    {
      "id": "contact",
      "label": "Contact",
      "route": "/contact"
    },
    {
      "id": "announcement_bar_preview",
      "label": "Announcement Bar Preview",
      "route": "/announcement-bar-preview"
    },
    {
      "id": "countdown_preview",
      "label": "Countdown Preview",
      "route": "/countdown-preview"
    }
  ],
